# =============================================================================
# Anvil environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit secrets.
#
# Most of these are not used in Phase 1; they're listed here so the scaffold is
# ready when later phases (synthesis, training, publishing) land.

# -----------------------------------------------------------------------------
# Hugging Face Hub
# -----------------------------------------------------------------------------
# Required to download gated base models (e.g. Llama 3.1) and to push the
# trained adapter + model card. Generate at:
# https://huggingface.co/settings/tokens — needs "write" scope for publishing.
HF_TOKEN=

# Cache directory for downloaded base models.
HF_HOME=./.cache/huggingface

# -----------------------------------------------------------------------------
# Experiment tracking
# -----------------------------------------------------------------------------
# Weights & Biases API key. Get from https://wandb.ai/authorize.
WANDB_API_KEY=
WANDB_PROJECT=anvil

# -----------------------------------------------------------------------------
# Dataset synthesis (Phase 3) and eval baseline (Phase 5)
# -----------------------------------------------------------------------------
# OpenAI key — used to synthesize training data and as the big-model eval
# baseline.
OPENAI_API_KEY=

# Anthropic key — used for the diversity-injection slice of synthesis.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Output locations
# -----------------------------------------------------------------------------
# Where committed results land (charts, eval JSON, cost JSON).
RESULTS_DIR=./results

# Where training outputs and checkpoints go (gitignored).
OUTPUTS_DIR=./outputs
